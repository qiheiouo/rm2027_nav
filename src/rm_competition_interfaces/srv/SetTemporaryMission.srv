# Trusted local Mission command; never a teammate-to-Nav2 bypass.
# Stable sequence/id/payload on retries. New commands increase sequence.
uint64 sequence
string mission_id
string kind
# Used only for kind=special; supply/recovery use reviewed configured poses.
geometry_msgs/PoseStamped target
builtin_interfaces/Time valid_until
bool cancel
---
bool accepted
string message
