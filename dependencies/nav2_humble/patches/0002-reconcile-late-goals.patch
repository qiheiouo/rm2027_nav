+  // Transfer this callback group to a finite cleanup operation. Its shared captures
+  // outlive a destroyed BT node; no cleanup callback may dereference that node.
+  // No deadline declares an unknown request safe: rejection or a terminal result
+  // is required before the group can return to normal BT execution.
+  void begin_goal_cleanup()
+  {
+    goal_callback_guard_.reset();
+    if (cleanup_pending_ || (!future_goal_handle_ && !goal_handle_)) {
+      return;
+    }
+    if (!rclcpp::ok(node_->get_node_base_interface()->get_context())) {
+      return;
+    }
+    callback_group_executor_.remove_callback_group(callback_group_);
+    cleanup_pending_ = std::make_shared<std::atomic<bool>>(true);
+    auto pending = future_goal_handle_;
+    auto active = goal_handle_;
+    future_goal_handle_.reset();
+    goal_handle_.reset();
+    feedback_.reset();
+    goal_result_available_ = false;
+    auto context = node_->get_node_base_interface()->get_context();
+    rclcpp::ExecutorOptions options;
+    options.context = context;
+    auto executor = std::make_shared<rclcpp::executors::SingleThreadedExecutor>(options);
+    auto stopped = std::make_shared<std::atomic<bool>>(false);
+    auto finished = std::make_shared<std::promise<void>>();
+    auto finished_future = finished->get_future().share();
+    std::weak_ptr<rclcpp::executors::SingleThreadedExecutor> weak_executor = executor;
+    auto shutdown_handle = context->add_pre_shutdown_callback(
+      [weak_executor, stopped, finished_future]() {
+        stopped->store(true);
+        // Cancellation may precede entry into spin; repeat the interrupt until
+        // resource teardown is complete, rather than racing context shutdown.
+        while (finished_future.wait_for(0s) != std::future_status::ready) {
+          if (auto cleanup_executor = weak_executor.lock()) {
+            cleanup_executor->cancel();
+          }
+          std::this_thread::yield();
+        }
+      });
+    std::weak_ptr<rclcpp::Context> weak_context = context;
+    std::thread([node = node_, client = action_client_, group = callback_group_,
+      pending, active, barrier = cleanup_pending_, name = action_name_, executor,
+      stopped, finished, weak_context, shutdown_handle]() mutable {
+        bool attached = false;
+        bool complete = true;
+        try {
+          executor->add_callback_group(group, node->get_node_base_interface());
+          attached = true;
+          using GoalHandle = rclcpp_action::ClientGoalHandle<ActionT>;
+          std::vector<std::shared_future<typename GoalHandle::WrappedResult>> results;
+          auto cancel_and_track = [&](typename GoalHandle::SharedPtr handle) {
+              if (!handle) {
+                return;  // Explicit goal rejection.
+              }
+              auto status = handle->get_status();
+              if (status == action_msgs::msg::GoalStatus::STATUS_SUCCEEDED ||
+                status == action_msgs::msg::GoalStatus::STATUS_ABORTED ||
+                status == action_msgs::msg::GoalStatus::STATUS_CANCELED)
+              {
+                return;
+              }
+              try {
+                results.push_back(client->async_get_result(handle));
+                if (status != action_msgs::msg::GoalStatus::STATUS_CANCELING) {
+                  client->async_cancel_goal(handle);
+                }
+              } catch (const rclcpp_action::exceptions::UnknownGoalHandleError &) {
+                status = handle->get_status();
+                if (status != action_msgs::msg::GoalStatus::STATUS_SUCCEEDED &&
+                  status != action_msgs::msg::GoalStatus::STATUS_ABORTED &&
+                  status != action_msgs::msg::GoalStatus::STATUS_CANCELED)
+                {
+                  throw;
+                }
+              }
+            };
+          // Cancel an executing old goal before awaiting an updated goal response.
+          cancel_and_track(active);
+          if (pending) {
+            if (!stopped->load() &&
+              executor->spin_until_future_complete(*pending) == rclcpp::FutureReturnCode::SUCCESS)
+            {
+              auto accepted = pending->get();
+              if (!active || !accepted || active->get_goal_id() != accepted->get_goal_id()) {
+                cancel_and_track(accepted);
+              }
+            } else {
+              complete = false;
+            }
+          }
+          for (auto & result : results) {
+            if (stopped->load() ||
+              executor->spin_until_future_complete(result) != rclcpp::FutureReturnCode::SUCCESS)
+            {
+              complete = false;
+            } else {
+              const auto code = result.get().code;
+              if (code != rclcpp_action::ResultCode::SUCCEEDED &&
+                code != rclcpp_action::ResultCode::ABORTED &&
+                code != rclcpp_action::ResultCode::CANCELED)
+              {
+                complete = false;
+              }
+            }
+          }
+        } catch (const std::exception & e) {
+          RCLCPP_ERROR(node->get_logger(), "Goal cleanup for %s failed: %s", name.c_str(), e.what());
+          complete = false;
+        }
+        if (attached) {
+          executor->remove_callback_group(group);
+        }
+        // Release all DDS entities before allowing Context::shutdown to proceed.
+        pending.reset();
+        active.reset();
+        executor.reset();
+        client.reset();
+        group.reset();
+        node.reset();
+        finished->set_value();
+        if (complete && !stopped->load()) {
+          barrier->store(false);
+        }
+        if (auto context = weak_context.lock()) {
+          context->remove_pre_shutdown_callback(shutdown_handle);
+        }
+      }).detach();
+  }
