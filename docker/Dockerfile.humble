FROM ros:humble-ros-base-jammy@sha256:5417e56962ff6e15d4cf9b2f78a71a78f3901f47cd78696b575b7eecdb54eb78

ARG DEBIAN_FRONTEND=noninteractive
ARG USERNAME=rmnav
ARG USER_UID=1000
ARG USER_GID=1000
ARG LIVOX_SDK2_REPO=https://github.com/Livox-SDK/Livox-SDK2.git
ARG LIVOX_SDK2_REF=f5d9375f84efe2b15bc0a052d3e18482ed13adf4

SHELL ["/bin/bash", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gnupg \
    lsb-release \
  && rm -rf /var/lib/apt/lists/*

RUN curl -sSL https://packages.osrfoundation.org/gazebo.gpg \
      --output /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg \
  && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] http://packages.osrfoundation.org/gazebo/ubuntu-stable $(lsb_release -cs) main" \
      > /etc/apt/sources.list.d/gazebo-stable.list

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    libapr1-dev \
    libaprutil1-dev \
    libegl1 \
    libgl1-mesa-dri \
    libpcl-dev \
    libqhull-dev \
    mesa-utils \
    python3-colcon-common-extensions \
    python3-pip \
    python3-rosdep \
    python3-vcstool \
    sudo \
    ros-humble-navigation2 \
    ros-humble-nav2-bringup \
    ros-humble-octomap-server \
    ros-humble-pcl-conversions \
    ros-humble-pcl-ros \
    ros-humble-openvdb-vendor=2.3.4-1jammy.20260304.075105 \
    ros-humble-robot-state-publisher \
    ros-humble-ros-gz-bridge \
    ros-humble-ros-gz-sim \
    ros-humble-rviz2 \
    ros-humble-spatio-temporal-voxel-layer=2.3.4-1jammy.20260607.082704 \
    ros-humble-nav2-rviz-plugins \
    ros-humble-tf2-tools \
    ros-humble-xacro \
    ignition-fortress \
  && rm -rf /var/lib/apt/lists/*

RUN git init /tmp/Livox-SDK2 \
  && git -C /tmp/Livox-SDK2 remote add origin "${LIVOX_SDK2_REPO}" \
  && git -C /tmp/Livox-SDK2 fetch --depth 1 origin "${LIVOX_SDK2_REF}" \
  && git -C /tmp/Livox-SDK2 checkout --detach FETCH_HEAD \
  && test "$(git -C /tmp/Livox-SDK2 rev-parse HEAD)" = "${LIVOX_SDK2_REF}" \
  && cmake -S /tmp/Livox-SDK2 -B /tmp/Livox-SDK2/build \
  && cmake --build /tmp/Livox-SDK2/build --parallel "$(nproc)" \
  && cmake --install /tmp/Livox-SDK2/build \
  && ldconfig \
  && rm -rf /tmp/Livox-SDK2

RUN if ! getent group "${USER_GID}" >/dev/null; then groupadd --gid "${USER_GID}" "${USERNAME}"; fi \
  && useradd --uid "${USER_UID}" --gid "${USER_GID}" --create-home "${USERNAME}" \
  && echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > "/etc/sudoers.d/${USERNAME}" \
  && chmod 0440 "/etc/sudoers.d/${USERNAME}"

RUN if [ ! -f /etc/ros/rosdep/sources.list.d/20-default.list ]; then rosdep init; fi || true

COPY docker/entrypoint.sh /rm_nav_entrypoint.sh
RUN chmod +x /rm_nav_entrypoint.sh

USER "${USERNAME}"
WORKDIR /workspace/rm2027_navigation

RUN rosdep update || true

ENTRYPOINT ["/rm_nav_entrypoint.sh"]
CMD ["bash"]
